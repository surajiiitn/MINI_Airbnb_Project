<% layout("/layouts/boilerplate.ejs") %>
<body>
    
    <div class="row">
    <form action="/listings" method="POST">
        
        <div class="col-8 offset-2">
            <h3>Create a New Listing : - </h3>
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control" name="listing[title]" placeholder="Enter Title" id="title">
        </div>

        <div class="mb-3">
            <label for="desc" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" placeholder="Enter Description" id="desc"></textarea>
        </div>

        <div class="mb-3">
            <label for="img" class="form-label">Image</label>
            <input type="text" class="form-control" name="listing[image]" placeholder="Enter Image URL/Link" id="img">
        </div>
        <div class="row">

        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input type="number" class="form-control" name="listing[price]" placeholder="Enter Price" id="price">
        </div>

        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" class="form-control" name="listing[country]" placeholder="Enter Country Name" id="country">
        </div>
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" class="form-control" name="listing[location]" placeholder="Enter Location" id="location">
        </div>
        <br>
        <button class="btn btn-dark mt-3 edit-btn">Add</button>
        </div>
    </form>
    </div>
    <br><br>
</body>
